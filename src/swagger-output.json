{
  "swagger": "2.0",
  "info": {
    "version": "v1.0.0",
    "title": "ROI API",
    "description": "Investment and referral based platform using the MERN Stack"
  },
  "host": "localhost:8000",
  "basePath": "/",
  "schemes": ["http", "https"],
  "paths": {
    "/api/v1/users/register": {
      "post": {
        "description": "Creates a new user account.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["fullName", "email", "mobileNumber", "password"],
              "properties": {
                "fullName": {
                  "type": "string",
                  "example": "Soumik Dhak"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "example": "soumik@gmail.com"
                },
                "mobileNumber": {
                  "type": "string",
                  "example": "9876543210"
                },
                "password": {
                  "type": "string",
                  "format": "password",
                  "example": "Password@123"
                },
                "referrelCode": {
                  "type": "string",
                  "example": "REF0001"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Invalid input or user already exists"
          }
        }
      }
    },
    "/api/v1/users/login": {
      "post": {
        "description": "",
