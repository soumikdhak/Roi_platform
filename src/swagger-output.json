    "/api/v1/investments/createInvestment": {
      "post": {
        "description": "Creates a new investment for the authenticated user.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "amount",
                "planDetails",
                "endDate",
                "dailyROIPercent"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "example": 10000,
                  "description": "Amount to invest"
                },
                "planDetails": {
                  "type": "string",
                  "example": "6 Months Investment Plan",
                  "description": "Details of the selected investment plan"
                },
                "endDate": {
                  "type": "string",
                  "format": "date",
                  "example": "2027-02-16",
                  "description": "Investment end date"
                },
                "dailyROIPercent": {
                  "type": "number",
                  "example": 1.5,
                  "description": "Daily ROI percentage"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Investment created successfully"
          },
          "400": {
            "description": "Invalid investment data or insufficient wallet balance"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
